<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>assets\app_icon.ico</ApplicationIcon>
    <AssemblyName>UniversalPCRemote</AssemblyName>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Universal PC Remote™ by Aniket Akal</Product>
    <Company>Aniket Akal</Company>
    <Authors>Aniket Akal</Authors>
    <Copyright>© 2026 Aniket Akal. All rights reserved.</Copyright>
    <Trademark>Universal PC Remote™ by Aniket Akal</Trademark>
    <Description>Universal PC Remote™ by Aniket Akal - Companion Server</Description>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>