{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Remote Command Protocol",
  "version": 1,
  "description": "Standardized command protocol for Universal PC Remote communication over WebSocket.",
  "definitions": {
    "CommandEnvelope": {
      "type": "object",
      "required": ["version", "requestId", "type", "timestamp", "payload"],
      "properties": {
        "version": { "type": "integer", "const": 1 },
        "requestId": { "type": "string", "format": "uuid" },
        "type": { "type": "string" },
        "timestamp": { "type": "integer" },
        "payload": { "type": "object" }
      }
    },
    "ResponseEnvelope": {
      "type": "object",
      "required": ["version", "requestId", "success", "type"],
      "properties": {
        "version": { "type": "integer", "const": 1 },
        "requestId": { "type": "string" },
        "type": { "type": "string" },
        "success": { "type": "boolean" },
        "data": { "type": ["object", "null"] },
        "error": {
          "type": ["object", "null"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          },
          "required": ["code", "message"]
        }
      }
    }
  }
}
